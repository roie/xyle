{
  "name": "xyle",
  "version": "0.0.0",
  "description": "A human-first visual editor for existing static websites",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/roie/xyle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roie/xyle.git"
  },
  "bugs": {
    "url": "https://github.com/roie/xyle/issues"
  },
  "type": "module",
  "bin": {
    "xyle": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets/brand/xyle-logo.png",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rolldown -c && wrangler pages functions build functions --outfile dist/xyle-worker.bundle",
    "build:website": "pnpm build && node scripts/build-website.mjs",
    "prepack": "pnpm build",
    "dev": "tsx src/cli.ts dev",
    "demo:reset": "node scripts/reset-demo.mjs",
    "demo:dev": "pnpm build:website && node scripts/serve-website.mjs --demo",
    "demo:workspace": "tsx src/cli.ts dev demo/.workspace/site",
    "website:dev": "pnpm build:website && node scripts/serve-website.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc -p functions/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:package": "node scripts/test-package.mjs",
    "test:cloudflare-runtime": "pnpm build && node scripts/test-cloudflare-runtime.mjs",
    "test:website": "pnpm build:website && node scripts/test-website.mjs",
    "check": "pnpm typecheck && pnpm test && ./node_modules/.bin/biome check .",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "blake3-wasm": "2.1.5",
    "parse5": "^8.0.1",
    "sharp": "^0.35.4",
    "wrangler": "^4.128.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "rolldown": "^1.2.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
